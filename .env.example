# --- Required: create an application at https://discord.com/developers/applications -------------
DISCORD_TOKEN=            # Bot tab → Reset Token
DISCORD_CLIENT_ID=        # General Information → Application ID
DISCORD_CLIENT_SECRET=    # OAuth2 → Client Secret (used for “Login with Discord”)

# Where people open the dashboard. Add BASE_URL/auth/callback as a Redirect in OAuth2 → Redirects.
BASE_URL=http://localhost:3000
PORT=3000
# Use 0.0.0.0 to accept connections from other machines (put HTTPS in front of it!).
HOST=127.0.0.1
# Set when running behind a reverse proxy (number of proxies, or true).
# TRUST_PROXY=1

# --- Optional -------------------------------------------------------------------------------------
# flowbot.sqlite and the uploads/ folder (uploaded pictures) live here: back up both.
DATA_DIR=data
# Who may edit a server's flows. Administrator (default, safest) or ManageGuild.
DASHBOARD_MIN_PERMISSION=Administrator
# Privileged intents: only turn these on after enabling them in the Developer Portal → Bot.
# Members: Member Joined/Left/Kicked/Timed Out, boost (Boosted Server/Stopped Boosting) and role-change triggers.
ENABLE_MEMBERS_INTENT=false
# Message Content: the “Message Received” trigger, and the text in ticket transcripts (without it they list who wrote when, not what).
ENABLE_MESSAGE_CONTENT_INTENT=false

# --- Limits (all UNLIMITED by default) -----------------------------------------------------------
# Cap only what you need; each takes a number or "unlimited". Recommended when other people use your bot:
# LIMIT_FLOWS_PER_GUILD=25
# LIMIT_NODES_PER_FLOW=150
# LIMIT_EDGES_PER_FLOW=400
# LIMIT_NODE_DATA_BYTES=24576
# LIMIT_GRAPH_BYTES=614400
# LIMIT_VARS_PER_GUILD=2000
# LIMIT_VAR_VALUE_BYTES=8192
# LIMIT_RUNS_PER_10S=40
# LIMIT_CONCURRENT_RUNS=15
# LIMIT_ACTIONS_PER_10S=25
# LIMIT_STEPS_PER_RUN=500
# LIMIT_LOOP_ITERATIONS=100
# LIMIT_WAIT_SECONDS=300
# LIMIT_COMPONENT_STATE_DAYS=90
# LIMIT_PAGES_PER_GUILD=25
# LIMIT_BLOCKS_PER_PAGE=60
# LIMIT_RESPONSES_PER_GUILD=5000
# LIMIT_UPLOAD_BYTES=10485760            # one uploaded picture (always at most 32 MB)
# LIMIT_UPLOADS_PER_GUILD=100
# LIMIT_STORAGE_BYTES_PER_GUILD=104857600
# LIMIT_TRANSCRIPT_MESSAGES=5000          # most messages one ticket transcript records
# HTTP request body ceiling (default 50 MB, at most 1 GB):
# LIMIT_REQUEST_BYTES=52428800

# ---- Alerts from other platforms ------------------------------------------------------------------------------------------------
# Feeds (New Feed Item): the shortest time a flow may wait between looks at a feed (default 5, at least 1):
# FEED_MIN_INTERVAL_MINUTES=5
# LIMIT_FEEDS_PER_GUILD=50                # feeds and channels one server may watch (unlimited unless set)
# Webhooks (Webhook Received): the biggest call accepted (default 65536, at most 262144) and the calls one address takes per minute (at most 600):
# LIMIT_WEBHOOK_BYTES=65536
# LIMIT_WEBHOOKS_PER_MINUTE=60
# Platform keys. Without them the matching trigger is shown as "not set up" in the editor and does nothing; feeds and webhooks need no key.
# YouTube subscriber milestones: a YouTube Data API v3 key (Google Cloud → APIs & Services → enable "YouTube Data API v3" → Credentials → API key).
# YOUTUBE_API_KEY=
# Twitch "channel went live": a free application at https://dev.twitch.tv/console (any redirect URL; category "Application Integration").
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
