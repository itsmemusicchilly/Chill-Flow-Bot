{
  "name": "chill-flow-bot",
  "version": "0.1.0",
  "private": true,
  "description": "A shared Discord bot whose behaviour server admins build in a web flowchart editor.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server/index.js",
    "build": "vite build",
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "test": "node --test --no-warnings=ExperimentalWarning \"test/**/*.test.js\"",
    "e2e": "node test/e2e/ui.e2e.mjs",
    "demo": "node --no-warnings=ExperimentalWarning scripts/demo-server.js",
    "docs": "node scripts/gen-docs.js",
    "backup": "node --no-warnings=ExperimentalWarning scripts/backup.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "discord.js": "^14.27.0",
    "express": "^5.2.1",
    "mongodb": "^6.21.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "undici": "^6.27.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright-core": "^1.63.0",
    "vite": "^8.3.1"
  }
}
